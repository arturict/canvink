# Build-time settings for the Tauri desktop app (`vite build --mode desktop`,
# run by `tauri build`; src-tauri/build.rs reads the same file). None of these
# values is secret. Put local overrides, such as a local Worker for testing,
# in `.env.desktop.local` (git-ignored).

# Sync Worker: personal-space sync and sharing.
VITE_COLLAB_SYNC_URL=https://canvink-sync.example.com
# Personal space: the signed-in account's notebooks sync with the web version.
VITE_PERSONAL_SPACE=1
# Web app that runs Clerk for the desktop sign-in (`/desktop-login`). Clerk
# itself never loads inside the desktop app, so no publishable key is needed.
VITE_DESKTOP_LOGIN_URL=https://canvink.example.com
