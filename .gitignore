# Dependencies and build output
node_modules/
dist/
dist-viewer/
coverage/
src-tauri/target/
src-tauri/gen/*
!src-tauri/gen/android/

# Test and tool output
playwright-report/
test-results/
*.log
pnpm-debug.log*

# Local configuration
.env
.env.*
!.env.example
!.env.desktop
.dev.vars
**/.dev.vars
.vercel/

# Local databases and notebook data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.canvink

# Credentials and signing material
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
.wrangler/

# Desktop installers are built on Windows and copied in before a web deploy; never committed.
/public/download/*.exe
/public/download/latest.json
/public/download/*.apk
/public/download/android.json
