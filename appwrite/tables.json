    "indexes": [
      {
        "key": "device_identity",
        "type": "unique",
        "attributes": ["deviceId"],
        "orders": ["ASC"]
      },
      {
        "key": "device_account",
        "type": "key",
        "attributes": ["accountId"],
        "orders": ["ASC"]
      },
      {
        "key": "device_member_status",
        "type": "key",
        "attributes": ["accountId", "status"],
        "orders": ["ASC", "ASC"]
      }
    ]
  },
  {
    "$id": "sync_device_challenges",
