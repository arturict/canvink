[
  {
    "$id": "sync_notebooks",
    "$permissions": [],
    "databaseId": "canvink-sync",
    "name": "Sync notebook sequence counters",
    "enabled": true,
    "rowSecurity": false,
    "columns": [
      {
        "key": "currentSequence",
        "type": "integer",
        "required": true,
        "min": 0,
        "max": 9007199254740991
      },
      { "key": "createdBy", "type": "varchar", "required": true, "size": 36 }
    ],
    "indexes": []
  },
  {
    "$id": "sync_device_accounts",
    "$permissions": [],
    "databaseId": "canvink-sync",
    "name": "Server-only first-device bootstrap guards",
    "enabled": true,
    "rowSecurity": false,
    "columns": [
      { "key": "accountId", "type": "varchar", "required": true, "size": 36 },
      {
        "key": "bootstrapDeviceId",
        "type": "varchar",
        "required": true,
        "size": 128
      },
      { "key": "createdAt", "type": "datetime", "required": true }
    ],
    "indexes": [
      {
        "key": "bootstrap_account",
        "type": "unique",
        "attributes": ["accountId"],
        "orders": ["ASC"]
      }
    ]
  },
  {
    "$id": "sync_devices",
    "$permissions": [],
    "databaseId": "canvink-sync",
    "name": "Account-bound public device directory",
    "enabled": true,
    "rowSecurity": true,
    "columns": [
      {
        "key": "protocolVersion",
        "type": "integer",
        "required": true,
        "min": 1,
        "max": 1
      },
      { "key": "accountId", "type": "varchar", "required": true, "size": 36 },
      { "key": "deviceId", "type": "varchar", "required": true, "size": 128 },
      {
        "key": "encryptionPublicKey",
        "type": "varchar",
        "required": true,
        "size": 43
      },
      {
        "key": "signingPublicKey",
        "type": "varchar",
        "required": true,
        "size": 43
      },
      {
        "key": "status",
        "type": "enum",
        "required": true,
        "elements": ["pending", "active", "revoked"]
      },
      { "key": "bootstrap", "type": "boolean", "required": true },
      {
        "key": "challengeVersion",
        "type": "integer",
        "required": true,
        "min": 0,
        "max": 2147483647
      },
      { "key": "createdAt", "type": "datetime", "required": true },
      { "key": "updatedAt", "type": "datetime", "required": true },
      { "key": "revokedAt", "type": "datetime", "required": false }
