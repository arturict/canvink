{
  "name": "@canvink/sync-function",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c ../../eslint.config.js src test --max-warnings 0",
    "test": "tsc -p tsconfig.json && node --test dist-test/test/*.test.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "node-appwrite": "27.1.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
