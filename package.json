{
  "name": "canvink",
  "version": "0.3.4",
  "private": true,
  "description": "A local-first notebook for ink, text, images, and PDFs.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturict/canvink.git"
  },
  "homepage": "https://canvink.vercel.app",
  "bugs": {
    "url": "https://github.com/arturict/canvink/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:android": "tsc -b && CANVINK_VIEWER=1 vite build --mode desktop",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "licenses:npm": "node scripts/check-npm-licenses.mjs",
    "release-marker:check": "node scripts/check-cargo-release-marker.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm release-marker:check && pnpm licenses:npm && pnpm build",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "preview": "vite preview",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "self-host:check": "node scripts/self-host-artifact-check.mjs dist",
    "self-host:docker-smoke": "node scripts/self-host-docker-smoke.mjs",
    "self-host:preflight": "node scripts/self-host-preflight.mjs",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --locked",
    "rust:check": "pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test",
    "security:cargo:audit": "cargo audit --file src-tauri/Cargo.lock",
    "security:cargo:deny": "cargo deny --manifest-path src-tauri/Cargo.toml --config .github/cargo-deny.toml check advisories bans licenses sources",
    "security:cargo": "pnpm security:cargo:audit && pnpm security:cargo:deny",
    "security:npm:audit": "pnpm audit --prod --audit-level high",
    "release:toolchain:check": "node scripts/local-release-toolchain-check.mjs",
    "release:preflight:local": "node scripts/local-release-preflight.mjs",
    "release:preflight:signed": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-signing.ps1 -Mode Preflight",
    "release:verify:signed": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-signing.ps1 -Mode VerifyBundle",
    "acceptance:windows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-school-acceptance.ps1",
    "acceptance:windows:checklist": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-school-acceptance.ps1 -Mode Checklist",
    "acceptance:windows:automated": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-school-acceptance.ps1 -Mode AutomatedTests",
    "acceptance:windows:launch": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-school-acceptance.ps1 -Mode LaunchBuiltApp",
    "acceptance:windows:test": "node --test scripts/windows-school-acceptance.test.mjs",
    "acceptance:math": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/math-canvas-acceptance.ps1",
    "acceptance:math:test": "node --test scripts/math-canvas-acceptance.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --ci -- --locked",
    "tauri:build:windows": "tauri build --bundles nsis,msi --ci -- --locked",
    "release:desktop": "bash scripts/release-desktop.sh",
    "release:android": "bash scripts/release-android.sh"
  },
  "dependencies": {
    "@automerge/automerge": "3.4.0",
    "@automerge/automerge-repo": "2.5.6",
    "@automerge/prosemirror": "0.2.0",
    "@azure/msal-browser": "5.17.3",
    "@clerk/clerk-react": "^5.61.6",
    "@clerk/localizations": "3.37.9",
    "@cortex-js/compute-engine": "0.100.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "appwrite": "26.2.0",
    "idb-keyval": "6.3.0",
    "jspdf": "4.2.1",
    "jsxgraph": "1.13.1",
    "konva": "10.3.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "lucide-react": "1.27.0",
    "markdown-it": "14.3.2",
    "mathlive": "0.110.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "perfect-freehand": "1.2.3",
    "prosemirror-commands": "1.7.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
