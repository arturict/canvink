{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvink",
  "version": "0.3.4",
  "identifier": "app.canvink.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Canvink",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://login.microsoftonline.com https://graph.microsoft.com https://canvink-sync.example.com wss://canvink-sync.example.com; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: https://img.clerk.com; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MTU4OUM0MTJFRkNBNUUKUldSZXl1OFN4SWtWRldxTjFyVnREZXAwSWpETHdYdnh2aXFFSkxtOFpFcUZFbU4wWll6UFBoR2UK",
      "endpoints": ["https://canvink.example.com/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["canvink"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "An open, local-first canvas notebook",
    "longDescription": "Canvink combines free-form pages, text, images, PDFs and handwriting in a local-first desktop notebook.",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "wix": {
        "version": "0.3.0.1"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
